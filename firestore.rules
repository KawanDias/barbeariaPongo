rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.date is string
        && request.resource.data.time is string;
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /services/{id} { allow read: if true; allow write: if isAdmin(database); }
    match /products/{id} { allow read: if true; allow write: if isAdmin(database); }
    match /gallery/{id} { allow read: if true; allow write: if isAdmin(database); }
    match /availability/{id} { allow read: if true; allow write: if isAdmin(database); }
    match /professionals/{id} { allow read: if true; allow write: if isAdmin(database); }
    match /customers/{id} { allow read, write: if request.auth != null && request.auth.uid == id; }
  }
  function isAdmin(database) {
    return request.auth != null && (request.auth.token.email == "barbeariapongo@gmail.com" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
  }
}
